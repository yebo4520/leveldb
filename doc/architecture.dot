digraph LevelDB_Architecture {
    rankdir=LR; // 从左到右布局
    node [shape=record, style=filled, fillcolor=lightgrey]; // Default node style, overridden by HTML-like

    subgraph cluster_api {
        label="Public API (include/leveldb/)";
        style=filled;
        color=lightblue;
        node [fillcolor=aliceblue]; // Nodes in this cluster unless overridden

        DB [label="{DB|Put(), Get(), Delete()\lNewIterator(), GetSnapshot()\lReleaseSnapshot(), Write()\l}"];
        Options [label="{Options|create_if_missing, error_if_exists\lcomparator, filter_policy\lblock_cache, block_size\lcompression, paranoid_checks\lenv\l...}"];
        ReadOptions [label="{ReadOptions|snapshot, fill_cache\lverify_checksums\l}"];
        WriteOptions [label="{WriteOptions|sync\l}"];
        Iterator [label="{Iterator|SeekToFirst(), SeekToLast()\lSeek(), Valid(), Next(), Prev()\lkey(), value(), status()\l}"];
        WriteBatch [label="{WriteBatch|Put(), Delete(), Clear()\l}"];
        Slice [label="{Slice|data(), size(), ToString()\l}"];
        Status [label="{Status|ok(), ToString()\l}"];
        Comparator [label="{Comparator|Compare(), Name()\lFindShortestSeparator()\lFindShortSuccessor()\l}"];
        Env [label="{Env|NewSequentialFile(), NewRandomAccessFile()\lNewWritableFile(), GetCurrentTimeMicros()\l...}"];
        Cache [label="{Cache|NewLRUCache()\lInsert(), Lookup(), Erase(), Value()\l}"];
        FilterPolicy [label="{FilterPolicy|NewBloomFilterPolicy()\lName(), CreateFilter(), KeyMayMatch()\l}"];
        Table [label="{Table|Open(), NewIterator()\l}"];
        TableBuilder [label="{TableBuilder|Add(), Finish(), Abandon()\l}"];
    }

    subgraph cluster_core_components {
        label="Core Components (db/, table/, util/)";
        style=filled;
        color=lightgoldenrodyellow;
        // node [fillcolor=lightyellow]; // Default for this cluster, overridden by HTML-like

        subgraph cluster_storage_engine {
            label="Storage Engine";
             node [shape=none, margin=0]; // Apply HTML-like settings to nodes in this sub-cluster by default

            MemTable [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" ID="MemTableMain" BGCOLOR="lightyellow">
  <TR><TD COLSPAN="1"><B>MemTable (in-memory)</B></TD></TR>
  <TR><TD ALIGN="LEFT" PORT="desc">Stores recent writes (SkipList)<BR ALIGN="LEFT"/>Consulted for reads<BR ALIGN="LEFT"/>Flushed to Level-0 SSTable<BR ALIGN="LEFT"/></TD></TR>
</TABLE>>];

            LogFile [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" ID="LogFileMain" BGCOLOR="lightyellow">
  <TR><TD COLSPAN="1"><B>Log File (*.log)</B></TD></TR>
  <TR><TD ALIGN="LEFT" PORT="desc">Sequential writes (updates)<BR ALIGN="LEFT"/>Converted to SSTable on rotation<BR ALIGN="LEFT"/></TD></TR>
</TABLE>>];

            SSTable [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" ID="SSTableMain" BGCOLOR="lightyellow">
  <TR><TD COLSPAN="1"><B>SSTable (*.ldb, on-disk)</B></TD></TR>
  <TR><TD ALIGN="LEFT" PORT="desc">Sorted key-value pairs<BR ALIGN="LEFT"/>Data Blocks, Index Block, Filter Block, Meta Blocks, Footer<BR ALIGN="LEFT"/>Organized in Levels (L0, L1, ...)<BR ALIGN="LEFT"/></TD></TR>
</TABLE>>];

            Manifest [shape=record, style=filled, fillcolor=lightyellow, label="{MANIFEST File|Metadata about SSTables per level\lKey ranges, versioning\l}"]; // Keep as record for now
            CurrentFile [shape=record, style=filled, fillcolor=lightyellow, label="{CURRENT File|Pointer to latest MANIFEST\l}"]; // Keep as record
            VersionSet [shape=record, style=filled, fillcolor=lightyellow, label="{VersionSet/Version/VersionEdit|Manages DB state (versions)\lTracks SSTables in levels\lHandles version transitions\l}"]; // Keep as record
        }

        subgraph cluster_processes {
            label="Key Processes";
            node [shape=record, style=filled, fillcolor=lightyellow]; // Keep as record for this cluster
            Compaction [label="{Compaction|Background process\lMerges SSTables (L0 to L1, L_i to L_i+1)\lReduces read cost, reclaims space\l}"];
            Recovery [label="{Recovery|Replays Log File on startup\lRebuilds MemTable\lEnsures consistency\l}"];
        }

        subgraph cluster_data_structures {
            label="Internal Data Structures & Utilities";
            node [shape=record, style=filled, fillcolor=lightyellow]; // Keep as record for this cluster
            SkipList [label="{SkipList|Probabilistic sorted data structure\lUsed by MemTable\l}"];
            Block [label="{Block (Data/Index/Meta)|Unit of I/O in SSTable\lOptionally compressed\l}"];
            BlockCache [label="{BlockCache (from Cache API)|Caches uncompressed blocks\l}"];
            Filter [label="{Filter (e.g., Bloom Filter)|Reduces disk reads for Get()\lAssociated with SSTables\l}"];
        }
    }

    // API to Core relationships
    DB -> MemTable;
    DB -> LogFile;
    DB -> SSTable;
    DB -> VersionSet;
    DB -> Compaction;
    DB -> Recovery;
    DB -> Options;
    DB -> ReadOptions;
    DB -> WriteOptions;
    DB -> Iterator;
    DB -> WriteBatch;
    DB -> Env;
    DB -> Cache;
    DB -> FilterPolicy;
    DB -> Comparator;

    Options -> Comparator;
    Options -> FilterPolicy;
    Options -> Cache;
    Options -> Env;

    Iterator -> SSTable;
    Iterator -> MemTable;

    WriteBatch -> DB;

    // Core component relationships
    MemTable -> SkipList;
    MemTable -> LogFile [label="replicates from (recovery)"]; // This might need port if LogFile has specific input ports for this
    LogFile -> MemTable [label="populates (writes)"];      // This might need port if MemTable has specific input ports
    LogFile -> SSTable [label="converted to L0"];

    SSTable -> Block;
    SSTable -> Filter;
    SSTable -> BlockCache;
    SSTable -> IndexBlock [label="contains", style=dotted];
    SSTable -> MetaIndexBlock [label="contains", style=dotted];

    VersionSet -> Manifest;
    VersionSet -> SSTable;
    Manifest -> SSTable;
    CurrentFile -> Manifest;

    Compaction -> SSTable;
    Compaction -> VersionSet;

    Recovery -> LogFile;
    Recovery -> MemTable;

    FilterPolicy -> Filter;
    Cache -> BlockCache;

    // Shared utilities (conceptual)
    Slice_User [shape=ellipse, style=filled, fillcolor=white, label="Slice (User Data)"];
    Slice_User -> Slice [style=dotted, arrowhead=none, label="represented as"];
    Slice_User -> DB [label="Key/Value for Put/Get"];
    Slice_User -> Iterator [label="Key/Value from iteration"];

    // High-level data flow for a write
    subgraph cluster_write_flow {
        label = "Write Path";
        rankdir=TD;
        style=dashed;
        node [shape=none, margin=0]; // Default for nodes in this subgraph

        WriteOp [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="palegreen">
  <TR><TD PORT="wr_op_port">Write(key, value)</TD></TR>
</TABLE>>];

        WriteOp:wr_op_port -> LogFile:LogFileMain [label="1. Append to Log"]; // Target main LogFile HTML node
        LogFile:LogFileMain -> MemTable:MemTableMain [label="2. Insert into MemTable", style=dashed]; // Target main MemTable HTML node

        MemTable_to_SSTable [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="lightcyan">
  <TR><TD>Later: MemTable full<BR ALIGN="LEFT"/>-&gt; Flush to Level-0 SSTable</TD></TR>
</TABLE>>];
        MemTable:MemTableMain -> MemTable_to_SSTable [style=dotted];
        MemTable_to_SSTable -> SSTable:SSTableMain [label="creates"]; // Target main SSTable HTML node
    }

    // High-level data flow for a read
    subgraph cluster_read_flow {
        label = "Read Path";
        rankdir=TD;
        style=dashed;
        node [shape=none, margin=0]; // Default for nodes in this subgraph

        ReadOp [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="palegreen">
  <TR><TD PORT="rd_op_port">Get(key)</TD></TR>
</TABLE>>];
        ReadOp:rd_op_port -> MemTable:MemTableMain [label="1. Check MemTable"]; // Target main MemTable

        Read_L0 [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="palegreen">
  <TR><TD PORT="rd_l0_port">2. Check Level-0 SSTables</TD></TR>
</TABLE>>];
        MemTable:MemTableMain -> Read_L0 [label="Not found?"];

        Read_L1plus [label=<
<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="palegreen">
  <TR><TD PORT="rd_l1p_port">3. Check Level-1..N SSTables<BR ALIGN="LEFT"/>(using index, filter, cache)</TD></TR>
</TABLE>>];
        Read_L0 -> Read_L1plus [label="Not found?"];
        Read_L1plus:rd_l1p_port -> SSTable:SSTableMain [label="accesses", style=dotted]; // Target main SSTable

        BlockCache_Read [shape=box, style="rounded,filled", fillcolor=lightpink, label="Block Cache"];
        Filter_Read [shape=box, style="rounded,filled", fillcolor=lightpink, label="Filter"];
        SSTable:SSTableMain -> BlockCache_Read [label="uses"];
        SSTable:SSTableMain -> Filter_Read [label="uses"];
    }
}
